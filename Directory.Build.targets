<Project>
  <!-- API surface tracking applies to every package we ship. SourceLink is only wired in CI so
       local builds without a git remote do not warn about missing source control information.
       README is packed centrally so core + modules share the same PackageReadmeFile. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
</Project>
