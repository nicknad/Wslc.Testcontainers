<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Wslc.Testcontainers</RootNamespace>
    <AssemblyName>Wslc.Testcontainers</AssemblyName>
    <PackageId>Wslc.Testcontainers</PackageId>
    <Description>Testcontainers-style ephemeral WSL containers for .NET integration tests, built on the Microsoft.WSL.Containers API.</Description>
    <PackageTags>wsl;containers;testing;integration-testing;testcontainers;windows</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WSL.Containers" />
  </ItemGroup>

</Project>
