root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,props,targets,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
# ADR-0005: CancellationToken position is kept for overload compatibility; And(...) is intentional DSL.
dotnet_diagnostic.CA1068.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_readonly_field = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# xUnit uses underscores in test names; example/test code favors readability over array caching.
[csharp/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1861.severity = none

[csharp/examples/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1861.severity = none

[*.{cpp,hpp,h}]
indent_size = 4
charset = utf-8
end_of_line = crlf
