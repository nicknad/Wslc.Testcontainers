---
# Analysis baseline for the C++ port. Checks are grouped the way the Microsoft
# C++ guidance recommends (bugs, performance, modernization, readability, Core
# Guidelines); opinionated or noisy checks are disabled explicitly.
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-convert-member-functions-to-static,
  -readability-duplicate-include,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-use-auto,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -bugprone-easily-swappable-parameters,
  -bugprone-macro-parentheses,
  -bugprone-empty-catch,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size,
  -performance-unnecessary-value-param,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-init-variables,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  -modernize-return-braced-init-list,
  -modernize-use-ranges,
  -modernize-raw-string-literal,
  -modernize-use-starts-ends-with,
  -modernize-use-emplace,
  -readability-uppercase-literal-suffix,
  -readability-make-member-function-const,
  -readability-named-parameter,
  -readability-math-missing-parentheses,
  -readability-qualified-auto,
  -readability-use-anyofallof,
  -readability-avoid-nested-conditional-operator,
  -bugprone-exception-escape,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-unchecked-optional-access,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-no-malloc,
  -cppcoreguidelines-owning-memory
WarningsAsErrors: "*"
# Anchor to the first-party cpp/ tree so FetchContent _deps and SDK headers never match.
HeaderFilterRegex: '[\\/]cpp[\\/](include|src|modules|tests)[\\/].*\.hpp$'
FormatStyle: file
UseColor: false
