<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(WslcTargetFrameworks)</TargetFrameworks>
    <WindowsSdkPackageVersion>10.0.26100.80</WindowsSdkPackageVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Wslc.Testcontainers.Modules.WireMock</RootNamespace>
    <AssemblyName>Wslc.Testcontainers.Modules.WireMock</AssemblyName>
    <PackageId>Wslc.Testcontainers.Modules.WireMock</PackageId>
    <Description>WireMock module for Wslc.Testcontainers: typed builder and HTTP endpoint for the WireMock API mock server.</Description>
    <PackageTags>wsl;containers;testing;integration-testing;testcontainers;windows;wiremock;http;api-mocking</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wslc.Testcontainers\Wslc.Testcontainers.csproj" />
  </ItemGroup>

</Project>
